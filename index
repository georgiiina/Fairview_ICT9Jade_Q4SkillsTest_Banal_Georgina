<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login - Virtual Notebook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #ffe4e1; font-family: sans-serif; }
        .login-container { margin-top: 100px; }
        .login-card { 
            background: white; 
            border: 2px solid #ff69b4; 
            border-radius: 20px; 
            padding: 40px; 
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
        }
        .btn-pink { background-color: #ff69b4; color: white; border: none; }
        .btn-pink:hover { background-color: #ff1493; color: white; }
        #login-status { color: #d63384; font-weight: bold; margin-top: 15px; }
    </style>
</head>
<body>

<div class="container d-flex justify-content-center login-container">
    <div class="login-card col-md-4 text-center">
        <h2 style="color: #ff69b4;">Notebook Login</h2>
        <p class="text-muted">Please enter your credentials</p>
        
        <input type="text" id="user_input" class="form-control mb-2" placeholder="Username">
        <input type="password" id="pass_input" class="form-control mb-3" placeholder="Password">
        
        <button id="loginBtn" class="btn btn-pink w-100" onclick="validateLogin()">Login</button>
        
        <p id="login-status"></p>
    </div>
</div>

<script>
  
    let attempt_counter = 0;

    function validateLogin() {
       
        let username = document.getElementById("user_input").value;
        let password = document.getElementById("pass_input").value;
        
    
        let granted = "Access Granted! Welcome.";
        let denied = "Access Denied!";


        do {
          
            if (username === "admin" && password === "1234") {
                alert(granted);
                attempt_counter = 0; 
                document.getElementById("login-status").innerHTML = "";
                window.location.href = "notebooks.html"; 
                break; 
            } else {
                attempt_counter++;
                document.getElementById("login-status").innerHTML =
                    denied + " Attempt " + attempt_counter + " of 3";
            }
        } while (false); 

 
        if (attempt_counter >= 3) {
            alert("Maximum attempts reached. System locked.");
            document.getElementById("loginBtn").disabled = true; 
            document.getElementById("loginBtn").innerText = "Locked";
        }
    }
</script>

</body>
</html>