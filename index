<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login - Virtual Notebook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #ffe4e1; font-family: sans-serif; }
        .login-card { 
            background-color: white; 
            border: 2px solid #ff69b4; 
            border-radius: 15px; 
            padding: 30px; 
            margin-top: 80px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .btn-pink { background-color: #ff69b4; color: white; border: none; }
        .btn-pink:hover { background-color: #ff1493; color: white; }
        #message { color: #d63384; font-size: 0.9rem; margin-top: 10px; }
    </style>
</head>
<body>

<div class="container d-flex justify-content-center">
    <div class="login-card col-md-4 text-center">
        <h2 style="color: #ff69b4;">Welcome Back</h2>
        <p>Please log in to your notebook</p>
        
        <input type="text" id="user_input" class="form-control mb-2" placeholder="Username">
        <input type="password" id="pass_input" class="form-control mb-3" placeholder="Password">
        
        <button id="loginButton" class="btn btn-pink w-100" onclick="checkLogin()">Login</button>
        
        <p id="message"></p>
        
        <br>
        <a href="https://www.w3schools.com" class="text-secondary small">Forgot password?</a>
    </div>
</div>

<script>
    // 1. Declare the counter OUTSIDE so it stays active
    let attempt_counter = 0;

    function checkLogin() {
        // 2. Retrieve input field values
        let username = document.getElementById("user_input").value;
        let password = document.getElementById("pass_input").value;
        
        // Variables for messages
        let success_msg = "Access Granted! Redirecting...";
        let denied_msg = "Access Denied!";

        // 3. Your Teacher's Loop Logic
        do {
            // Note: Replace "admin" and "1234" with whatever login you want
            if (username === "admin" && password === "1234") {
                alert(success_msg);
                attempt_counter = 0; // reset after success
                document.getElementById("message").innerHTML = "";
                window.location.href = "notebooks.html"; // go to second page
                break; // stop loop
            } else {
                attempt_counter++;
                document.getElementById("message").innerHTML =
                    "Incorrect username and/or password. Attempt " + attempt_counter + " of 3";
            }
        } while (false); 

        // 4. Lockout Logic
        if (attempt_counter >= 3) {
            alert("Too many failed attempts. Button locked.");
            document.getElementById("loginButton").disabled = true; // lock button
            document.getElementById("loginButton").innerText = "Locked";
        }
    }
</script>

</body>
</html>